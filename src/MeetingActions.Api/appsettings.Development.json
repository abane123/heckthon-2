{
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "meeting_actions_dev"
  },
  "Llm": {
    "Provider": "Ollama",
    "FallbackToStub": true
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.1:8b",
    "NumCtx": 16384,
    "Temperature": 0,
    "RequestTimeoutSeconds": 180,
    "MaxTranscriptCharsPerChunk": 6000,
    "KeepAlive": "10m"
  },
  "TaskProvider": {
    "Type": "AzureDevOps"
  },
  "AzureDevOps": {
    "OrganizationUrl": "https://example.invalid",
    "Project": "replace-with-project",
    "PersonalAccessToken": ""
  },
  "AzureOpenAI": {
    "Endpoint": "https://example.invalid",
    "Deployment": "replace-with-deployment",
    "ApiKey": ""
  },
  "Teams": {
    "WebhookUrl": "https://example.invalid/webhook"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
